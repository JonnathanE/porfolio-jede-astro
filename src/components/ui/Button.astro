---
interface Props {
    variant?: "primary" | "outline" | "accent" | "inverse";
    size?: "md" | "lg";
    href?: string;
    target?: "_blank" | "_self" | "_parent" | "_top";
    class?: string;
}

const {
    variant = "primary",
    size = "md",
    href,
    target,
    class: className,
    ...rest
} = Astro.props;

const base =
    "inline-flex items-center justify-center gap-2 font-bold rounded-xl transition-opacity duration-200 cursor-pointer hover:opacity-90";

const variants = {
    primary: "bg-primary text-on-primary",
    outline: "border-[1.5px] border-text text-text",
    accent: "bg-accent text-on-accent",
    inverse: "border-[1.5px] border-on-primary text-on-primary",
};

const sizes = {
    md: "min-h-12 px-6 text-base",
    lg: "min-h-14 px-8 text-lg",
};

const classes = [base, variants[variant], sizes[size], className].join(" ");
const Tag = href ? "a" : "button";
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<Tag href={href} target={target} rel={rel} class={classes} {...rest}>
    <slot />
</Tag>
