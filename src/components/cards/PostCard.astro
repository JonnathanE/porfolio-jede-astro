---
import Tag from "@/components/ui/Tag.astro";
import { formatPostDate, getReadingTime, type Post } from "@utils/blog";

interface Props {
    post: Post;
}

const { post } = Astro.props;
const { title, excerpt, category, date } = post.data;
---

<a
    href={`/blog/${post.id}`}
    class="flex flex-col gap-3 rounded-2xl border border-line bg-surface p-6 transition-colors hover:bg-surface-alt"
>
    <Tag variant="soft" class="self-start">{category}</Tag>
    <h3 class="text-xl font-bold leading-snug text-text">{title}</h3>
    <p class="text-[15px] leading-relaxed text-muted">{excerpt}</p>
    <span class="font-mono text-xs text-muted">
        <time datetime={date.toISOString()}>{formatPostDate(date)}</time>{" "}
        · {getReadingTime(post)} min de lectura
    </span>
</a>
