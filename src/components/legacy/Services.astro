---
import { Image } from "astro:assets";

import SectionContainer from "@/components/sections/SectionContainer.astro";
import TitleSection from "@/components/sections/TitleSection.astro";

import WebIconImg from "@assets/images/web-icon.png";
import RightArrowImg from "@assets/images/right-arrow.png";
import MobileIconImg from "@assets/images/mobile-icon.png";
import UiIconImg from "@assets/images/ui-icon.png";
import GraphicsIconImg from "@assets/images/graphics-icon.png";
---

<SectionContainer id="services">
  <TitleSection
    subtitle="SERVICES"
    title="Our Features & Services"
    description="Comprehensive solutions tailored to bring your digital ideas to life with modern technologies and best practices."
  />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 my-10">
    <div
      class="border border-gray-400 rounded-lg px-8 py-12 hover:shadow-[4px_4px_0px_#000] cursor-pointer hover:bg-[#fcf4ff] hover:-translate-y-1 duration-500 dark:hover:shadow-white dark:hover:bg-darkTheme/50"
    >
      <Image src={WebIconImg} alt="web icon" class="w-10" />
      <h3 class="text-lg my-4 text-gray-700 dark:text-white">Web design</h3>
      <p class="text-sm text-gray-600 leading-5 dark:text-white/80">
        Web development is the process of building, programming...
      </p>
      <a href="" class="flex items-center gap-2 text-sm mt-5"
        >Read more<Image src={RightArrowImg} alt="right arrow" class="w-4" /></a
      >
    </div>
    <div
      class="border border-gray-400 rounded-lg px-8 py-12 hover:shadow-[4px_4px_0px_#000] cursor-pointer hover:bg-[#fcf4ff] hover:-translate-y-1 duration-500 dark:hover:shadow-white dark:hover:bg-darkTheme/50"
    >
      <Image src={MobileIconImg} alt="web icon" class="w-10" />
      <h3 class="text-lg my-4 text-gray-700 dark:text-white">Mobile app</h3>
      <p class="text-sm text-gray-600 leading-5 dark:text-white/80">
        Web development is the process of building, programming...
      </p>
      <a href="" class="flex items-center gap-2 text-sm mt-5"
        >Read more<Image src={RightArrowImg} alt="right arrow" class="w-4" /></a
      >
    </div>
    <div
      class="border border-gray-400 rounded-lg px-8 py-12 hover:shadow-[4px_4px_0px_#000] cursor-pointer hover:bg-[#fcf4ff] hover:-translate-y-1 duration-500 dark:hover:shadow-white dark:hover:bg-darkTheme/50"
    >
      <Image src={UiIconImg} alt="web icon" class="w-10" />
      <h3 class="text-lg my-4 text-gray-700 dark:text-white">UI/ UX design</h3>
      <p class="text-sm text-gray-600 leading-5 dark:text-white/80">
        Web development is the process of building, programming...
      </p>
      <a href="" class="flex items-center gap-2 text-sm mt-5"
        >Read more<Image src={RightArrowImg} alt="right arrow" class="w-4" /></a
      >
    </div>
    <div
      class="border border-gray-400 rounded-lg px-8 py-12 hover:shadow-[4px_4px_0px_#000] cursor-pointer hover:bg-[#fcf4ff] hover:-translate-y-1 duration-500 dark:hover:shadow-white dark:hover:bg-darkTheme/50"
    >
      <Image src={GraphicsIconImg} alt="web icon" class="w-10" />
      <h3 class="text-lg my-4 text-gray-700 dark:text-white">
        Graphics design
      </h3>
      <p class="text-sm text-gray-600 leading-5 dark:text-white/80">
        Web development is the process of building, programming...
      </p>
      <a href="" class="flex items-center gap-2 text-sm mt-5"
        >Read more<Image src={RightArrowImg} alt="right arrow" class="w-4" /></a
      >
    </div>
  </div>
</SectionContainer>
