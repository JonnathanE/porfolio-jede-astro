---
import { Icon } from "astro-icon/components";
import { navItems } from "@/constants/navItems";
import SimpleThemeToggle from "@/components/widgets/SimpleThemeToggle.astro";
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center pt-6 px-4">
    <nav
        id="navbar"
        class="flex items-center gap-1 px-2 py-2 rounded-full border border-surface-alt bg-surface/80 backdrop-blur-md shadow-lg shadow-black/5 transition-all duration-300 w-full md:w-auto justify-between md:justify-center"
    >
        <!-- Mobile Menu Button -->
        <button
            id="mobile-menu-btn"
            class="flex md:hidden items-center justify-center p-2 rounded-full text-text hover:bg-surface-alt transition-colors"
            aria-label="Toggle menu"
        >
            <Icon name="menu" size={24} />
        </button>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center gap-1">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        data-nav-item
                        class={[
                            "flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200",
                            item.active
                                ? "bg-text text-surface"
                                : "text-muted hover:text-text hover:bg-surface-alt",
                        ].join(" ")}
                    >
                        <Icon name={item.icon} size={16} />
                        <span>{item.label}</span>
                    </a>
                ))
            }
        </div>

        <SimpleThemeToggle />
    </nav>

    <!-- Mobile Menu Dropdown -->
    <div
        id="mobile-menu"
        class="md:hidden fixed top-24 left-4 right-4 bg-surface/95 backdrop-blur-md border border-surface-alt rounded-2xl shadow-2xl shadow-black/10 overflow-hidden transition-all duration-300 opacity-0 invisible -translate-y-2.5"
    >
        <div class="flex flex-col py-2">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        data-nav-item-mobile
                        class={[
                            "flex items-center gap-3 px-6 py-4 text-base font-medium transition-all duration-200 border-l-4",
                            item.active
                                ? "bg-surface-alt text-text border-text"
                                : "text-muted hover:text-text hover:bg-surface-alt border-transparent",
                        ].join(" ")}
                    >
                        <Icon name={item.icon} size={20} />
                        <span>{item.label}</span>
                    </a>
                ))
            }
        </div>
    </div>
</header>

<script>
    const navLinks =
        document.querySelectorAll<HTMLAnchorElement>("[data-nav-item]");
    const navLinksMobile = document.querySelectorAll<HTMLAnchorElement>(
        "[data-nav-item-mobile]",
    );
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    // Mobile menu toggle
    let isMobileMenuOpen = false;

    const toggleMobileMenu = () => {
        isMobileMenuOpen = !isMobileMenuOpen;
        if (mobileMenu) {
            if (isMobileMenuOpen) {
                mobileMenu.classList.remove(
                    "opacity-0",
                    "invisible",
                    "translate-y-[-10px]",
                );
                mobileMenu.classList.add(
                    "opacity-100",
                    "visible",
                    "translate-y-0",
                );
            } else {
                mobileMenu.classList.add(
                    "opacity-0",
                    "invisible",
                    "translate-y-[-10px]",
                );
                mobileMenu.classList.remove(
                    "opacity-100",
                    "visible",
                    "translate-y-0",
                );
            }
        }
    };

    mobileMenuBtn?.addEventListener("click", toggleMobileMenu);

    // Close mobile menu when clicking on a link
    navLinksMobile.forEach((link) => {
        link.addEventListener("click", () => {
            if (isMobileMenuOpen) {
                toggleMobileMenu();
            }
        });
    });

    // Close mobile menu when clicking outside
    document.addEventListener("click", (e) => {
        if (
            isMobileMenuOpen &&
            mobileMenu &&
            !mobileMenu.contains(e.target as Node) &&
            !mobileMenuBtn?.contains(e.target as Node)
        ) {
            toggleMobileMenu();
        }
    });

    const setActive = (activeLink: HTMLAnchorElement) => {
        navLinks.forEach((link) => {
            const isActive = link === activeLink;
            link.classList.toggle("bg-text", isActive);
            link.classList.toggle("text-surface", isActive);
            link.classList.toggle("text-muted", !isActive);
            link.classList.toggle("hover:text-text", !isActive);
            link.classList.toggle("hover:bg-surface-alt", !isActive);
        });
    };

    const setActiveMobile = (activeLink: HTMLAnchorElement) => {
        navLinksMobile.forEach((link) => {
            const isActive = link === activeLink;
            link.classList.toggle("bg-surface-alt", isActive);
            link.classList.toggle("text-text", isActive);
            link.classList.toggle("border-text", isActive);
            link.classList.toggle("text-muted", !isActive);
            link.classList.toggle("border-transparent", !isActive);
        });
    };

    navLinks.forEach((link) => {
        link.addEventListener("click", () => setActive(link));
    });

    navLinksMobile.forEach((link) => {
        link.addEventListener("click", () => setActiveMobile(link));
    });

    // Highlight on scroll
    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    // Update desktop nav
                    const active = document.querySelector<HTMLAnchorElement>(
                        `[data-nav-item][href="#${entry.target.id}"]`,
                    );
                    if (active) setActive(active);

                    // Update mobile nav
                    const activeMobile =
                        document.querySelector<HTMLAnchorElement>(
                            `[data-nav-item-mobile][href="#${entry.target.id}"]`,
                        );
                    if (activeMobile) setActiveMobile(activeMobile);
                }
            });
        },
        {
            threshold: 0.3,
            // rootMargin: "-20% 0px -50% 0px",
        },
    );

    sections.forEach((s) => observer.observe(s));
</script>
