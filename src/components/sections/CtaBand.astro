---
import { SITE } from "@/constants/site";
import Button from "@/components/ui/Button.astro";
---

<section class="mx-auto max-w-280 px-6 py-20">
    <div
        class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
    >
        <div class="flex max-w-2xl flex-col gap-3">
            <h2 class="text-3xl font-extrabold tracking-tight text-balance md:text-4xl">
                ¿Tienes un puesto o un proyecto en mente?
            </h2>
            <p class="text-lg leading-relaxed text-muted">
                Cuéntame qué necesitas y vemos si encajamos.
            </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
            <Button href="/contact">Contáctame</Button>
            <Button
                href="/contact"
                variant="outline"
                data-email={SITE.emailEncoded}
            >
                Escríbeme un correo
            </Button>
        </div>
    </div>
</section>

<script>
    import "@/scripts/revealEmail";
</script>
