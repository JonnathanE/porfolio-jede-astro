---
import { SITE } from "@/constants/site";
import Button from "@/components/ui/Button.astro";
---

<section class="mx-auto max-w-280 px-6 pb-20">
    <div
        class="flex flex-col items-center gap-4 rounded-3xl bg-primary px-8 py-14 text-center text-on-primary"
    >
        <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
            ¿Construimos algo juntos?
        </h2>
        <p class="max-w-lg text-lg leading-relaxed">
            Cuéntame tu idea y buscamos la mejor forma de llevarla a producción.
        </p>
        <div class="mt-2 flex flex-wrap justify-center gap-3">
            <Button href="/contact" variant="accent">Contáctame</Button>
            <Button
                href="/contact"
                variant="inverse"
                data-email={SITE.emailEncoded}
            >
                Escríbeme un correo
            </Button>
        </div>
    </div>
</section>

<script>
    import "@/scripts/revealEmail";
</script>
