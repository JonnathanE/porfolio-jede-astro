---
import { Icon } from "astro-icon/components";

import SectionContainer from "@/components/sections/SectionContainer.astro";
import TitleSection from "@/components/sections/TitleSection.astro";

import ProjectCard from "@/components/sections/ProjectCard.astro";
---

<SectionContainer id="projects">
    <TitleSection
        subtitle="PROYECTOS"
        title="Trabajo Destacado"
        description="Una muestra de mis proyectos recientes que demuestran experiencia en desarrollo full-stack, frameworks modernos y resolución creativa de problemas."
    />
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 my-10">
        <ProjectCard
            image="images/work-1.png"
            title="App de Finanzas"
            description="Aplicación web para gestionar ingresos y egresos personales con autenticación y dashboard."
            github="https://github.com/JonnathanE"
            website="https://github.com/JonnathanE"
            youtube="https://youtu.be/7HgJIAUtICU"
            tech={["React", "Node.js", "MongoDB", "Tailwind CSS"]}
        />

        <ProjectCard
            image="images/work-2.png"
            title="Panel de Control IoT"
            description="Sistema de monitoreo en tiempo real para dispositivos conectados vía MQTT."
            github="https://github.com/JonnathanE"
            website=""
            youtube=""
            tech={["Angular", "Express", "PostgreSQL", "Docker"]}
        />

        <ProjectCard
            image="images/work-3.png"
            title="Portafolio Personal"
            description="Mi portafolio creado con Astro y Tailwind para mostrar mis proyectos y habilidades."
            github="https://github.com/JonnathanE"
            website="https://github.com/JonnathanE"
            youtube=""
            tech={["Astro", "Tailwind CSS", "Vite"]}
        />
    </div>

    <div class="text-center mt-10">
        <a
            href="/#sill"
            class="w-max flex intems-center justify-center gap-2 text-text border-[0.5px] border-text rounded-full py-3 px-10 mx-auto my-20 duration-500 hover:bg-surface-alt"
            >Ver más proyectos <Icon name="arrow-right" size={24} />
        </a>
    </div>
</SectionContainer>
