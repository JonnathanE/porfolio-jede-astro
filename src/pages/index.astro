---
import Layout from "@layouts/Layout.astro";

import Navbar from "@/components/sections/Navbar.astro";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import Skills from "@/components/sections/Skills.astro";
import Experience from "@/components/sections/Experience.astro";
import Portfolio from "@/components/sections/Portfolio.astro";
import Footer from "@/components/sections/Footer.astro";
---

<Layout
    title="Portafolio de Jonnathan Espinoza - Desarrollador y Programador Web"
    description="Contrata a Jonnathan Espinoza, un desarrollador web con más de 3 años de experiencia en la creación de aplicaciones únicas y personalizadas. Hábil en HTML, CSS, JavaScript y frameworks modernos. Jonnathan está listo para llevar su proyecto al siguiente nivel."
    image="/images/perfil_hero.jpeg"
>
    <main>
        <Navbar />
        <Hero />
        <About />
        <Skills />
        <Experience />
        <Portfolio />
        <Footer />
    </main>
</Layout>
