---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";

import PageLayout from "@layouts/PageLayout.astro";
import Button from "@/components/ui/Button.astro";
import Tag from "@/components/ui/Tag.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ProjectCard from "@/components/cards/ProjectCard.astro";
import PostCard from "@/components/cards/PostCard.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import { EXPERIENCE, type Experience } from "@/constants/experience";
import { PROJECTS } from "@/constants/projects";
import { SITE } from "@/constants/site";
import { socialLinks } from "@/constants/socialLinks";
import { TECH_CATEGORIES, getTechnology } from "@/constants/technologies";
import { getPosts } from "@utils/blog";

import HeroCharacter from "@assets/images/hero-character.webp";

const featuredExperience = EXPERIENCE.find((exp) => exp.feature);
const otherExperience = EXPERIENCE.filter(
    (exp) => exp !== featuredExperience,
).slice(0, 2);
const experiencePeriod = (exp: Experience) =>
    `${exp.startMonth} ${exp.startYear} – ${
        exp.currentlyWorking ? "Actualidad" : `${exp.endMonth} ${exp.endYear}`
    }`;
const featuredProjects = PROJECTS.slice(0, 3);
const latestPosts = (await getPosts()).slice(0, 3);
---

<PageLayout
    title="Jonnathan Espinoza | Desarrollador Full Stack"
    description="Desarrollador Full Stack especializado en Backend, con más de 4 años construyendo software para el sector financiero: APIs REST, bases de datos, ETL e interfaces."
    image="/images/perfil_hero.jpg"
>
    <section
        class="mx-auto flex max-w-280 flex-wrap items-center gap-12 px-6 pt-16 pb-20"
    >
        <div class="flex min-w-0 flex-1 basis-120 flex-col gap-6">
            <h1
                class="text-5xl font-extrabold leading-[1.08] tracking-tight md:text-6xl"
            >
                Hola, soy <span class="inline-block text-primary">{SITE.name}</span>
            </h1>
            <div class="flex flex-wrap gap-2">
                {SITE.roles.map((role) => <Tag variant="soft">{role}</Tag>)}
            </div>
            <p class="max-w-xl text-lg leading-relaxed text-pretty text-muted">
                {SITE.tagline}
            </p>
            <div class="flex flex-wrap gap-3">
                <Button href="/contact">
                    <Icon name="email-plus" size={18} />
                    Contáctame
                </Button>
                <Button href={SITE.cv} variant="outline" target="_blank">
                    <Icon name="download-outline" size={18} />
                    Descargar CV
                </Button>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-muted">Encuéntrame en:</span>
                {
                    socialLinks.map(({ icon, href, label }) => (
                        <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={label}
                            class="flex h-12 w-12 items-center justify-center rounded-xl hover:bg-surface-alt"
                        >
                            <Icon name={icon} size={28} />
                        </a>
                    ))
                }
            </div>
        </div>
        <div class="flex flex-1 basis-80 justify-center">
            <Picture
                src={HeroCharacter}
                alt="Foto de Jonnathan Espinoza"
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                width={896}
                widths={[400, 672, 896]}
                sizes="(min-width: 496px) 448px, calc(100vw - 48px)"
                priority
                class="aspect-square w-full max-w-md rounded-3xl border border-line object-cover object-[50%_25%]"
            />
        </div>
    </section>

    <section class="border-y border-line bg-surface-alt">
        <div class="mx-auto flex max-w-280 flex-col gap-10 px-6 py-20">
            <SectionHeading
                eyebrow="Trayectoria"
                icon="suitcase-line" title="Experiencia"
                href="/experience"
                linkLabel="Ver el detalle de mi experiencia"
            />
            {
                featuredExperience?.feature && (
                    <article class="grid gap-10 rounded-3xl bg-primary p-6 text-on-primary md:p-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-12 lg:p-12">
                        <div class="flex flex-col gap-5">
                            <span class="font-mono text-sm">
                                {experiencePeriod(featuredExperience)}
                            </span>
                            <h3 class="text-[clamp(2.25rem,11.5vw,6rem)] leading-none font-extrabold tracking-tight lg:text-[clamp(4.5rem,7.5vw,6rem)]">
                                {featuredExperience.feature.name}
                            </h3>
                            <p class="max-w-lg text-xl leading-snug font-bold text-pretty md:text-2xl">
                                {featuredExperience.feature.product}
                            </p>
                            <p class="leading-relaxed">
                                {featuredExperience.feature.role}
                                <br />
                                {featuredExperience.company}
                            </p>
                        </div>
                        <dl class="self-center">
                            {
                                featuredExperience.feature.scope.map(
                                    ({ label, detail }) => (
                                        <div class="border-t border-on-primary/30 py-3.5 first:border-t-0 first:pt-0 last:pb-0">
                                            <dt class="font-bold">{label}</dt>
                                            <dd class="mt-0.5 text-[15px] leading-relaxed text-on-primary/85">
                                                {detail}
                                            </dd>
                                        </div>
                                    ),
                                )
                            }
                        </dl>
                    </article>
                )
            }
            <div class="grid gap-x-12 gap-y-8 md:grid-cols-2">
                {
                    otherExperience.map((exp) => (
                        <article class="flex flex-col gap-2 border-t border-line pt-5">
                            <span class="font-mono text-xs text-muted">
                                {experiencePeriod(exp)}
                            </span>
                            <h3 class="text-lg font-bold leading-snug">
                                {exp.title}
                            </h3>
                            <span class="font-semibold text-primary">
                                {exp.company}
                            </span>
                            <p class="text-[15px] leading-relaxed text-muted">
                                {exp.summary}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="mx-auto flex max-w-280 flex-col gap-10 px-6 py-20">
        <SectionHeading
            eyebrow="Trabajo personal"
            icon="folder-outline" title="Proyectos"
            href="/projects"
            linkLabel="Ver todos los proyectos"
        />
        <div
            class:list={[
                "grid gap-6 md:grid-cols-2",
                featuredProjects.length >= 3 && "lg:grid-cols-3",
            ]}
        >
            {featuredProjects.map((project) => <ProjectCard {project} />)}
        </div>
    </section>

    <section class="border-y border-line bg-surface-alt">
        <div class="mx-auto flex max-w-280 flex-col gap-10 px-6 py-20">
            <SectionHeading eyebrow="Con qué trabajo" icon="git-branch" title="Tecnologías" />
            <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                {
                    TECH_CATEGORIES.map((group) => (
                        <section class="flex flex-col gap-4 rounded-2xl border border-line bg-surface p-6">
                            <h3 class="font-mono text-xs font-medium tracking-widest text-primary uppercase">
                                {group.title}
                            </h3>
                            <ul class="flex flex-wrap gap-2">
                                {group.items.map((id) => {
                                    const tech = getTechnology(id);
                                    return (
                                        <li class="flex items-center gap-2 rounded-xl bg-surface-alt px-3 py-2 text-[15px] font-semibold">
                                            <Icon name={tech.icon} size={18} />
                                            {tech.name}
                                        </li>
                                    );
                                })}
                            </ul>
                        </section>
                    ))
                }
            </div>
        </div>
    </section>

    {
        latestPosts.length > 0 && (
            <section class="mx-auto flex max-w-280 flex-col gap-10 px-6 pt-20">
                <SectionHeading
                    eyebrow="Escribo sobre lo que aprendo"
                    icon="blog"
                    title="Últimos artículos"
                    href="/blog"
                    linkLabel="Ver el blog"
                />
                <div
                    class:list={[
                        "grid gap-5",
                        latestPosts.length === 1
                            ? "max-w-2xl"
                            : "md:grid-cols-2 lg:grid-cols-3",
                    ]}
                >
                    {latestPosts.map((post) => <PostCard {post} />)}
                </div>
            </section>
        )
    }

    <CtaBand />
</PageLayout>
