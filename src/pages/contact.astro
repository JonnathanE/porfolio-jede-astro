---
import PageLayout from "@layouts/PageLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import { SITE } from "@/constants/site";
import { socialLinks } from "@/constants/socialLinks";

const fieldClass =
    "w-full rounded-xl border border-line bg-surface-alt px-4 text-text placeholder:text-muted/70 focus-visible:outline-2 focus-visible:outline-primary";
---

<PageLayout
    title="Contacto | Jonnathan Espinoza"
    description="Ponte en contacto con Jonnathan Espinoza para tu próximo proyecto."
>
    <div class="mx-auto flex max-w-280 flex-col gap-12 px-6 pt-16 pb-20">
        <PageHeader
            eyebrow="Hablemos"
            title="Contacto"
            description="Cuéntame tu idea y buscamos la mejor forma de llevarla a producción."
        />

        <div class="flex flex-wrap items-start gap-8">
            <form
                class="flex min-w-0 flex-1 basis-130 flex-col gap-5 rounded-2xl border border-line p-8"
            >
                <div class="flex flex-col gap-2">
                    <label for="nombre" class="font-semibold">Nombre</label>
                    <input
                        id="nombre"
                        name="nombre"
                        type="text"
                        autocomplete="name"
                        placeholder="Tu nombre"
                        class={`${fieldClass} min-h-12`}
                    />
                </div>
                <div class="flex flex-col gap-2">
                    <label for="correo" class="font-semibold">
                        Correo electrónico
                    </label>
                    <input
                        id="correo"
                        name="correo"
                        type="email"
                        autocomplete="email"
                        placeholder="tucorreo@ejemplo.com"
                        class={`${fieldClass} min-h-12`}
                    />
                </div>
                <div class="flex flex-col gap-2">
                    <label for="mensaje" class="font-semibold">Mensaje</label>
                    <textarea
                        id="mensaje"
                        name="mensaje"
                        rows="6"
                        placeholder="¿En qué te puedo ayudar?"
                        class={`${fieldClass} py-3.5`}></textarea>
                </div>
                <Button type="submit" class="self-start">Enviar mensaje</Button>
            </form>

            <aside class="flex min-w-0 flex-1 basis-72 flex-col gap-4">
                <div
                    class="flex flex-col gap-2.5 rounded-2xl border border-line bg-surface-alt p-6"
                >
                    <span class="font-mono text-xs tracking-widest text-muted">
                        CORREO
                    </span>
                    <a
                        href={`mailto:${SITE.email}`}
                        class="break-all text-lg font-bold hover:underline"
                    >
                        {SITE.email}
                    </a>
                </div>
                <div
                    class="flex flex-col gap-1 rounded-2xl border border-line bg-surface-alt p-6"
                >
                    <span
                        class="mb-1.5 font-mono text-xs tracking-widest text-muted"
                    >
                        REDES
                    </span>
                    {
                        socialLinks.map(({ label, href }) => (
                            <a
                                href={href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex min-h-11 items-center font-semibold hover:underline"
                            >
                                {label} ↗
                            </a>
                        ))
                    }
                </div>
                <div
                    class="flex items-center gap-2.5 rounded-2xl border border-line p-6 text-muted"
                >
                    <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-green-600"></span>
                    Disponible para trabajos independientes · {SITE.location}
                </div>
            </aside>
        </div>
    </div>
</PageLayout>
