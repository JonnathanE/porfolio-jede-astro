---
import Layout from "@layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const props = Astro.props;
---

<Layout {...props}>
    <a
        href="#contenido"
        class="sr-only z-60 rounded-xl bg-primary font-bold text-on-primary focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:px-4 focus:py-3"
    >
        Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
        <slot />
    </main>
    <Footer />
</Layout>
